  "Knowledge_Docs": [
    {
      "doc_id": "DOC-ELECTRICAL_CABINET-CORE",
      "title": "Electrical cabinet condition context",
      "scope": "ELECTRICAL_CABINET",
      "content": "Use enclosure temperature, door seal condition, termination tightness and recent panel work together. Treat elevated internal temperature, moisture ingress or loose terminals as signals to inspect on site, not as proof of failure.",
      "synthetic_record": true
    },
    {
      "doc_id": "DOC-HANDWHEEL_VALVE-CORE",
      "title": "Handwheel valve inspection context",
      "scope": "HANDWHEEL_VALVE",
      "content": "Use stem packing condition, handwheel motion, visible leakage and line isolation status together. Stiff motion, weeping packing or an unverified line-up are reasons to verify manually before changing the valve position.",
      "synthetic_record": true
    },
    {
      "doc_id": "DOC-VALVE_ACTUATOR-CORE",
      "title": "Valve actuator diagnostic context",
      "scope": "VALVE_ACTUATOR",
      "content": "Use supply pressure, actuator travel, feedback consistency and linkage condition together. Low supply, sluggish travel or drifting feedback warrant pneumatic and mechanical checks, not immediate replacement.",
      "synthetic_record": true
    }
  ],
